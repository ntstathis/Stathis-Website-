---
// Contact — EN twin of /epikoinwnia/. Same layout; texts verbatim from the
// old /en/contact/ page (the broken "http://Tel: …" hrefs of the old site are
// replaced with proper tel:/mailto: links, visible text unchanged).
import Base from '../../../layouts/Base.astro';
import ContactForm from '../../../components/ContactForm.astro';

const maps = {
  thessaloniki: 'https://maps.google.com/maps?q=40.679629120994,22.805246114731&z=13&hl=en&output=embed',
  athens: 'https://maps.google.com/maps?q=38.082723324416,23.787503242493&z=13&hl=en&output=embed',
};
---

<Base
  lang="en"
  title="Contact - Stathis"
  path="en/contact"
  twinPath="epikoinwnia"
  headerColor="white"
  padTop={false}
>
  <div id="contactPage">
    <section class="hero bg-grey">
      <div class="container-fluid">
        <div class="row mb-md-65 mb-40">
          <div class="col-md-7">
            <h1 class="ff-pfdin-bold fs-xl-48 fs-md-40 fs-32">Contact</h1>
          </div>
          <div class="col-md-5 d-flex align-items-end">
            <p class="fs-18">"Stathis" is located in Thessaloniki and Athens</p>
          </div>
        </div>
        <div class="row pb-md-80 pb-40 row_map">
          <div class="col-md-6">
            <div class="map_wrapper">
              <div class="black_box">
                <ul class="links list-unstyled">
                  <li><p>Building Block 6, A' Zoni, Symvoli 4-A9, Sindos Industrial Area, 57022, Echedoro 570 22, Greece</p></li>
                  <li><a href="tel:+302310798300">Tel: +30 2310 79 8300</a></li>
                  <li><a href="mailto:contact@stathis.com.gr">Email: contact@stathis.com.gr</a></li>
                </ul>
              </div>
              <div class="acf-map">
                <iframe
                  src={maps.thessaloniki}
                  title="Map — Head Office / Factory Thessaloniki"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen></iframe>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="map_wrapper">
              <div class="black_box">
                <ul class="links list-unstyled">
                  <li><p>Andrea Metaxa 11Α, Kifisia 145 64, Greece</p></li>
                  <li><a href="tel:+302105584160">Tel: +30 210 55 84 160</a></li>
                  <li><a href="mailto:athens@stathis.com.gr">Email: athens@stathis.com.gr</a></li>
                </ul>
              </div>
              <div class="acf-map">
                <iframe
                  src={maps.athens}
                  title="Map — Athens Branch"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen></iframe>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="form mt-md-80 mt-40">
      <div class="container-fluid">
        <div class="row">
          <div class="col-12">
            <p class="form_title ff-pfdin-bold fs-20">If you have any question or how we can support your business, please contact with us or fill our short feedback form.</p>
          </div>
        </div>
        <div class="row">
          <div class="col-12">
            <div id="theme_form">
              <ContactForm lang="en" />
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .mb-40 { margin-bottom: 4rem; }
  .pb-40 { padding-bottom: 4rem; }
  .mt-40 { margin-top: 4rem; }
  @media (min-width: 768px) {
    .row.mb-md-65 { margin-bottom: 6.5rem; }
    .pb-md-80 { padding-bottom: 8rem; }
    .mt-md-80 { margin-top: 8rem; }
  }

  #contactPage section.hero { padding-top: calc(var(--navigation_height) + 10rem); }
  #contactPage .row_map { row-gap: 2rem; }
  #contactPage .map_wrapper { position: relative; }
  #contactPage .map_wrapper .black_box {
    background-color: var(--black);
    bottom: 0;
    color: var(--white);
    left: 0;
    max-width: 100%;
    min-height: 160px;
    padding: 2rem;
    position: absolute;
    width: 300px;
    z-index: 2;
  }
  #contactPage .map_wrapper .black_box .links { display: flex; flex-direction: column; }
  #contactPage .map_wrapper .black_box .links li:not(:last-child) { margin-bottom: 0.5rem; }
  #contactPage .map_wrapper .black_box .links li a,
  #contactPage .map_wrapper .black_box .links li p { color: var(--white); font-size: 1.6rem; }
  #contactPage .map_wrapper .acf-map { border: none; margin: 0; min-height: 370px; width: 100%; }
  #contactPage .map_wrapper .acf-map iframe { border: 0; display: block; height: 370px; width: 100%; }
  #contactPage section.form .form_title { max-width: 600px; }
  #contactPage section.form #theme_form { max-width: 800px; }
  @media (max-width: 767.98px) {
    #contactPage section.hero { padding-top: calc(var(--navigation_height) + 5rem); }
  }
</style>
