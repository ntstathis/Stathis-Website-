---
// Διαμορφωτής — full-viewport iframe of the sales configurator, replicating
// the old template-iframe page (which had no footer and a 100vw×100vh iframe).
import Base from '../../layouts/Base.astro';
---

<Base
  lang="el"
  title="Διαμορφωτής - Stathis"
  path="diamorfwtis"
  twinPath="en/configurator"
  headerColor="grey"
  padTop={false}
>
  <div class="iframe_wrapper">
    <iframe
      src="https://sales.stathis.com.gr/configurator"
      title="configurator"
      style="width: 100vw; height: 100vh;"
      frameborder="0"
      allowfullscreen></iframe>
  </div>
</Base>

<style is:global>
  /* the old template-iframe page renders no footer */
  #site_footer {
    display: none;
  }
</style>
