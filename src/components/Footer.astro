---
// Site footer: logo + blurb + socials, company links, Thessaloniki HQ,
// Athens branch, copyright bar. Faithful to the old four-column layout.
import { Image } from 'astro:assets';
import type { Lang } from '../lib/i18n';
import { footerData, contacts, langHome } from '../lib/i18n';
import logo from '../assets/img/site/logo-stathis.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const data = footerData[lang];
const hq = lang === 'el' ? contacts.thessaloniki : contacts.thessalonikiEn;
const branch = lang === 'el' ? contacts.athens : contacts.athensEn;
const year = new Date().getFullYear();
---

<footer id="site_footer">
  <div class="container-fluid">
    <div class="row mb-md-65 mb-50">
      <div class="col-lg-4 col-md-6">
        <div class="footer_logo text-md-start text-center mb-md-45 mb-30">
          <a href={langHome[lang]}>
            <Image class="logo_img" src={logo} alt="Stathis Logo" width={277} height={68} />
          </a>
        </div>
        <p class="fs-16 text-md-start text-center mb-25">{data.blurb}</p>
        <ul class="socials list-unstyled d-flex align-items-center justify-content-md-start justify-content-center">
          <li>
            <a href={contacts.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
            </a>
          </li>
          <li>
            <a href={contacts.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05v-2.66c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.88v2.27h3.32l-.53 3.49h-2.79V24C18.61 23.09 24 18.1 24 12.07z"/></svg>
            </a>
          </li>
        </ul>
      </div>

      <div class="col-lg-2 col-md-6 mt-md-0 mt-50">
        <h4 class="ff-pfdin-bold fs-20 mb-25">{data.companyTitle}</h4>
        <nav>
          <ul class="footer_links list-unstyled">
            {data.companyLinks.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="col-lg-3 col-md-6 mt-lg-0 mt-50">
        <h4 class="ff-pfdin-bold fs-20 mb-25">{data.hqTitle}</h4>
        <nav>
          <ul class="footer_links list-unstyled">
            {hq.map((l) => (
              <li class={l.href ? '' : 'unclickable'}>
                <a href={l.href ?? '#'}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="col-lg-3 col-md-6 mt-lg-0 mt-50">
        <h4 class="ff-pfdin-bold fs-20 mb-25">{data.branchTitle}</h4>
        <nav>
          <ul class="footer_links list-unstyled">
            {branch.map((l) => (
              <li class={l.href ? '' : 'unclickable'}>
                <a href={l.href ?? '#'}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <div class="row mb-md-20 mb-15">
      <div class="col-12">
        <p class="text-center text-text_grey fs-16">Copyright © {year} stathis.com.gr - All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
