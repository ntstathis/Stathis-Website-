---
// Catalog entry page (koala refrigerated containers + ready vehicles).
// Mirrors the old Elementor product-post structure (export/skeletons/
// koala-80.txt): gallery → text body → side images → "Data sheet" button.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Gallery from '../components/Gallery.astro';

interface Props {
  entry: CollectionEntry<'koala'> | CollectionEntry<'vehicles'>;
  twinPath: string | null;
}
const { entry, twinPath } = Astro.props;
const d = entry.data;

const ASSETS = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/img/**/*.{jpg,jpeg,png,webp,gif}',
  { eager: true },
);
const meta = (src?: string) => (src && ASSETS[src]?.default) || null;

// og:image: explicit seo.ogImage wins; else first gallery image
const ogImage = d.seo.ogImage
  ? (meta(d.seo.ogImage)?.src ?? d.seo.ogImage)
  : meta(d.images?.[0]?.src)?.src;

const bodyImages = (d.bodyImages ?? []).map((im) => {
  const m = meta(im.src);
  if (!m) console.warn(`[CatalogLayout] body image not found in src/assets glob, using raw path: ${im.src}`);
  return { ...im, meta: m };
});
---

<Base
  lang={d.lang}
  title={d.seo.title}
  description={d.seo.description}
  path={d.path}
  {twinPath}
  {ogImage}
  noindex={d.seo.noindex}
>
  <div id="catalogPage" class="container-fluid">
    <h1 class="visually_hidden">{d.title}</h1>

    {d.images && d.images.length > 0 && (
      <div class="row">
        <div class="col-12">
          <Gallery images={d.images} title={d.title} />
        </div>
      </div>
    )}

    <div class="row">
      <div class="col-12">
        <div class="container_max_content">
          <div class="catalog_body">
            <slot />
          </div>

          {bodyImages.length > 0 && (
            <div class="row row_body_images">
              {bodyImages.map((im) => (
                <div class="col-md-6">
                  {im.meta ? <Image src={im.meta} alt={im.alt} loading="lazy" /> : <img src={im.src} alt={im.alt} loading="lazy" />}
                </div>
              ))}
            </div>
          )}

          {d.datasheet && (
            <div class="datasheet_wrapper text-center">
              <a class="btn_black" href={d.datasheet} target="_blank" rel="noopener">Data sheet</a>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  #catalogPage {
    padding-top: 5rem;
  }
  @media (min-width: 768px) {
    #catalogPage {
      padding-top: 10rem;
    }
  }

  .visually_hidden {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .catalog_body {
    margin-top: 4rem;
  }
  .catalog_body :global(p),
  .catalog_body :global(li) {
    font-size: 1.8rem;
    line-height: 1.5;
  }
  .catalog_body :global(p) {
    margin-bottom: 1.5rem;
  }
  .catalog_body :global(ul),
  .catalog_body :global(ol) {
    margin-bottom: 1rem;
  }
  .catalog_body :global(li:not(:last-child)) {
    margin-bottom: 0.5rem;
  }
  .catalog_body :global(a) {
    text-decoration: underline;
  }
  .catalog_body :global(img) {
    height: auto;
    max-width: 100%;
  }

  .row_body_images {
    align-items: center;
    margin-top: 4rem;
    row-gap: 2rem;
  }
  .row_body_images :global(img) {
    height: auto;
    margin-inline: auto;
  }

  .datasheet_wrapper {
    margin-top: 4rem;
  }
</style>
