---
// Prose page (pages + products collections). Mirrors the old page template
// (export/skeletons/privacy.txt, micro-rafia.txt): H1 + optional gallery +
// body constrained to .container_max_content (950px). Raw HTML blocks in the
// body marked .alignwide/.alignfull escape the readable column.
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Gallery from '../components/Gallery.astro';

interface Props {
  entry: CollectionEntry<'pages'> | CollectionEntry<'products'>;
  twinPath: string | null;
}
const { entry, twinPath } = Astro.props;
const d = entry.data;

const ASSETS = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/img/**/*.{jpg,jpeg,png,webp,gif}',
  { eager: true },
);
const meta = (src?: string) => (src && ASSETS[src]?.default) || null;

const ogImage = d.seo.ogImage
  ? (meta(d.seo.ogImage)?.src ?? d.seo.ogImage)
  : meta(d.images?.[0]?.src)?.src;
---

<Base
  lang={d.lang}
  title={d.seo.title}
  description={d.seo.description}
  path={d.path}
  {twinPath}
  {ogImage}
  noindex={d.seo.noindex}
>
  <div id="prosePage" class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div id="page">
          <div class="gutenberg-content">
            <div class="container_max_content">
              <h1 class="ff-pfdin-bold fs-md-40 fs-32">{d.title}</h1>

              {d.images && d.images.length > 0 && (
                <div class="prose_gallery">
                  <Gallery images={d.images} title={d.title} />
                </div>
              )}

              <div class="prose_body">
                <slot />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  /* old theme: .pt-md-100 .pt-50 on the page wrapper */
  #prosePage {
    padding-top: 5rem;
  }
  @media (min-width: 768px) {
    #prosePage {
      padding-top: 10rem;
    }
  }

  /* h1: .fs-xl-48 .mb-md-60 .mb-30 equivalents */
  h1 {
    margin-bottom: 3rem;
  }
  @media (min-width: 768px) {
    h1 {
      margin-bottom: 6rem;
    }
  }
  @media (min-width: 1200px) {
    h1 {
      font-size: 4.8rem;
    }
  }

  .prose_gallery {
    margin-bottom: 4rem;
  }

  /* prose body — .gutenberg-content rules from the old bundle */
  .prose_body :global(p),
  .prose_body :global(li),
  .prose_body :global(blockquote) {
    font-size: 1.8rem;
    line-height: 1.5;
  }
  .prose_body :global(h1),
  .prose_body :global(h2),
  .prose_body :global(h3),
  .prose_body :global(h4) {
    margin-bottom: 3rem;
    margin-top: 3rem;
  }
  .prose_body :global(figure),
  .prose_body :global(ol),
  .prose_body :global(p),
  .prose_body :global(ul) {
    margin: 0 0 1rem;
  }
  .prose_body :global(a) {
    text-decoration: underline;
  }
  .prose_body :global(img),
  .prose_body :global(video) {
    height: auto;
    max-width: 100%;
  }
  .prose_body :global(table) {
    border-collapse: collapse;
    font-size: 1.6rem;
    margin-bottom: 1rem;
    max-width: 100%;
  }
  .prose_body :global(th),
  .prose_body :global(td) {
    border: 1px solid var(--grey);
    padding: 0.8rem 1.2rem;
    text-align: left;
  }
  /* WP flex image galleries embedded in page HTML */
  .prose_body :global(figure.is-layout-flex) {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .prose_body :global(figure.is-layout-flex > figure) {
    flex: 1 1 200px;
    margin: 0;
  }
  .prose_body :global(figure.is-layout-flex img) {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  /* full-width HTML blocks escape the 950px readable column */
  .prose_body :global(.alignwide) {
    max-width: none;
  }
  .prose_body :global(.alignfull) {
    margin-inline: calc(50% - 50vw);
    max-width: 100vw;
    width: 100vw;
  }
</style>
