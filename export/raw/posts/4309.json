DZM0K32ASISBZM0K32ASISCZM0K32ASISDYM0K32ASISCYM0K32ASISBYM0-768x768.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K32ASISDZM0K32ASISBZM0K32ASISCZM0K32ASISDYM0K32ASISCYM0K32ASISBYM0-1024x1024.webp\"\n    data-title=\"K32ASISDZM0K32ASISBZM0K32ASISCZM0K32ASISDYM0K32ASISCYM0K32ASISBYM0\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/768;\">\n\n<img decoding=\"async\" alt=\"K32ASISDZM0K32ASISBZM0K32ASISCZM0K32ASISDYM0K32ASISCYM0K32ASISBYM0-2-600x600\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/K32ASISDZM0K32ASISBZM0K32ASISCZM0K32ASISDYM0K32ASISCYM0K32ASISBYM0-2-600x600-1.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K32ASISDZM0K32ASISBZM0K32ASISCZM0K32ASISDYM0K32ASISCYM0K32ASISBYM0-2-600x600-1.webp\"\n    data-title=\"K32ASISDZM0K32ASISBZM0K32ASISCZM0K32ASISDYM0K32ASISCYM0K32ASISBYM0-2-600x600\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 600px; --smush-placeholder-aspect-ratio: 600/600;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"0\" data-end=\"328\">This <strong data-start=\"5\" data-end=\"38\">27-liter isothermal container</strong> ensures maximum thermal performance and is ideal for the safe transport of temperature-sensitive products. Made from high-quality polyethylene and insulated with CFC- and HCFC-free polyurethane foam, it protects the organoleptic properties of food and reduces the risk of bacterial growth.</p><ul data-start=\"330\" data-end=\"693\" data-is-last-node=\"\" data-is-only-node=\"\"><li data-start=\"330\" data-end=\"357\"><p data-start=\"332\" data-end=\"357\"><strong data-start=\"332\" data-end=\"344\">Capacity</strong>: 27 liters</p></li><li data-start=\"358\" data-end=\"411\"><p data-start=\"360\" data-end=\"411\"><strong data-start=\"360\" data-end=\"372\">Material</strong>: Durable and insulating polyethylene</p></li><li data-start=\"412\" data-end=\"487\"><p data-start=\"414\" data-end=\"487\"><strong data-start=\"414\" data-end=\"428\">Insulation</strong>: Eco-friendly polyurethane foam (free of CFCs and HCFCs)</p></li><li data-start=\"488\" data-end=\"580\"><p data-start=\"490\" data-end=\"580\"><strong data-start=\"490\" data-end=\"506\">Power supply</strong>: Functional design compatible with dual power sources, 12Vdc and 230Vac</p></li><li data-start=\"581\" data-end=\"693\" data-is-last-node=\"\"><p data-start=\"583\" data-end=\"693\" data-is-last-node=\"\"><strong data-start=\"583\" data-end=\"609\">User-friendly handling</strong>: Top-opening lid and integrated carrying handles for safe and comfortable transport</p></li></ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b80f4fb e-con-full e-flex e-con e-child\" data-id=\"b80f4fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t