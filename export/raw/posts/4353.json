    "rendered": "\t\t<div data-elementor-type=\"wp-post\" data-elementor-id=\"4353\" class=\"elementor elementor-4353\" data-elementor-post-type=\"post\">\n\t\t\t\t<div class=\"elementor-element elementor-element-7f110e3 e-flex e-con-boxed e-con e-parent\" data-id=\"7f110e3\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a53ae7a elementor-widget elementor-widget-ucaddon_uc_compact_image_theme\" data-id=\"a53ae7a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_uc_compact_image_theme.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Compact Gallery -->\n\t\t<link id='font-awesome-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/font-awesome6/fontawesome-all.min.css' type='text/css' rel='stylesheet' >\n\t\t<link id='font-awesome-4-shim-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/font-awesome6/fontawesome-v4-shims.min.css' type='text/css' rel='stylesheet' >\n\t\t<link id='unitegallery-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/unitegallery/css/unite-gallery.css' type='text/css' rel='stylesheet' >\n\n<style>/* widget: Compact Gallery */\n\n#uc_uc_compact_image_theme_elementor_a53ae7a-wrapper{\n  min-height: 1px;\n}\n\n#uc_uc_compact_image_theme_elementor_a53ae7a{\n  margin:0 auto;\n  display: none;\n}\n\n</style>\n\n<div id=\"uc_uc_compact_image_theme_elementor_a53ae7a-wrapper\">\n  <div id=\"uc_uc_compact_image_theme_elementor_a53ae7a\" class=\"uc-items-wrapper  \"  data-remote-type=\"gallery\" data-custom-sethtml=\"true\" >\n    \n<img decoding=\"async\" alt=\"K160ASISDZM0K160ASISBZM0K160ASISCZM0K160ASISDYM0K160ASISCYM0K160ASISBYM0\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/K160ASISDZM0K160ASISBZM0K160ASISCZM0K160ASISDYM0K160ASISCYM0K160ASISBYM0-768x768.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K160ASISDZM0K160ASISBZM0K160ASISCZM0K160ASISDYM0K160ASISCYM0K160ASISBYM0-1024x1024.webp\"\n    data-title=\"K160ASISDZM0K160ASISBZM0K160ASISCZM0K160ASISDYM0K160ASISCYM0K160ASISBYM0\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/768;\">\n\n<img decoding=\"async\" alt=\"K160ASISBYM0-300x300\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/K160ASISBYM0-300x300-1.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K160ASISBYM0-300x300-1.webp\"\n    data-title=\"K160ASISBYM0-300x300\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 300px; --smush-placeholder-aspect-ratio: 300/300;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"0\" data-end=\"265\">The <strong data-start=\"4\" data-end=\"17\">KOALA 160</strong> is a mobile refrigerated container designed for the safe transport and optimal temperature preservation of temperature-sensitive products. Featuring an integrated cooling unit and a top-opening design, it offers ease of use and maximum efficiency.</p><ul data-start=\"267\" data-end=\"809\" data-is-last-node=\"\" data-is-only-node=\"\"><li data-start=\"267\" data-end=\"369\"><p data-start=\"269\" data-end=\"369\"><strong data-start=\"269\" data-end=\"290\">Internal capacity</strong>: 162 liters, ideal for transporting and storing temperature-controlled goods</p></li><li data-start=\"370\" data-end=\"575\"><p data-start=\"372\" data-end=\"401\"><strong data-start=\"372\" data-end=\"398\">High-quality materials</strong>:</p><ul data-start=\"404\" data-end=\"575\"><li data-start=\"404\" data-end=\"463\"><p data-start=\"406\" data-end=\"463\">Durable polyethylene structure, built for intensive use</p></li><li data-start=\"466\" data-end=\"575\"><p data-start=\"468\" data-end=\"575\">Eco-friendly polyurethane foam insulation, free of CFCs and HCFCs, ensuring excellent thermal performance</p></li></ul></li><li data-start=\"576\" data-end=\"656\"><p data-start=\"578\" data-end=\"656\"><strong data-start=\"578\" data-end=\"605\">Integrated cooling unit</strong>: Provides consistent and efficient refrigeration</p></li><li data-start=\"657\" data-end=\"736\"><p data-start=\"659\" data-end=\"736\"><strong data-start=\"659\" data-end=\"679\">Practical design</strong>: Top-opening lid allows for easy loading and unloading</p></li><li data-start=\"737\" data-end=\"809\" data-is-last-node=\"\"><p data-start=\"739\" data-end=\"809\" data-is-last-node=\"\"><strong data-start=\"739\" data-end=\"764\">Available with wheels</strong>: For enhanced mobility and ease of transport</p></li></ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b80f4fb e-con-full e-flex e-con e-child\" data-id=\"b80f4fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9fc7267 elementor-widget elementor-widget-image\" data-id=\"9fc7267\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/haccp2.webp\" class=\"attachment-large size-large wp-image-2874 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-57b5a8b elementor-widget elementor-widget-image\" data-id=\"57b5a8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/riciclo2.webp\" class=\"attachment-large size-large wp-image-2875 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-54c0076 e-con-full e-flex e-con e-child\" data-id=\"54c0076\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-32056d2 elementor-align-center elementor-widget elementor-widget-button\" data-id=\"32056d2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\