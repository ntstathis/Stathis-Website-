    "rendered": "\t\t<div data-elementor-type=\"wp-post\" data-elementor-id=\"4388\" class=\"elementor elementor-4388\" data-elementor-post-type=\"post\">\n\t\t\t\t<div class=\"elementor-element elementor-element-36c63a6 e-flex e-con-boxed e-con e-parent\" data-id=\"36c63a6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-f50753d elementor-widget elementor-widget-ucaddon_uc_compact_image_theme\" data-id=\"f50753d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_uc_compact_image_theme.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Compact Gallery -->\n\t\t<link id='font-awesome-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/font-awesome6/fontawesome-all.min.css' type='text/css' rel='stylesheet' >\n\t\t<link id='font-awesome-4-shim-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/font-awesome6/fontawesome-v4-shims.min.css' type='text/css' rel='stylesheet' >\n\t\t<link id='unitegallery-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/unitegallery/css/unite-gallery.css' type='text/css' rel='stylesheet' >\n\n<style>/* widget: Compact Gallery */\n\n#uc_uc_compact_image_theme_elementor_f50753d-wrapper{\n  min-height: 1px;\n}\n\n#uc_uc_compact_image_theme_elementor_f50753d{\n  margin:0 auto;\n  display: none;\n}\n\n</style>\n\n<div id=\"uc_uc_compact_image_theme_elementor_f50753d-wrapper\">\n  <div id=\"uc_uc_compact_image_theme_elementor_f50753d\" class=\"uc-items-wrapper  \"  data-remote-type=\"gallery\" data-custom-sethtml=\"true\" >\n    \n<img decoding=\"async\" alt=\"Contenitore-isotermico-refrigerato-–-KOALA-495\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/Contenitore-isotermico-refrigerato-–-KOALA-495-768x768.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/Contenitore-isotermico-refrigerato-–-KOALA-495-1024x1024.webp\"\n    data-title=\"Contenitore-isotermico-refrigerato-–-KOALA-495\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/768;\">\n\n<img decoding=\"async\" alt=\"KOALA-495-APERTO-SCATOLE-600x459\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-495-APERTO-SCATOLE-600x459-1.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-495-APERTO-SCATOLE-600x459-1.webp\"\n    data-title=\"KOALA-495-APERTO-SCATOLE-600x459\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 600px; --smush-placeholder-aspect-ratio: 600/459;\">\n\n<img decoding=\"async\" alt=\"KOALA-495-RUOTE-APERTO-600x900\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-495-RUOTE-APERTO-600x900-1.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-495-RUOTE-APERTO-600x900-1.webp\"\n    data-title=\"KOALA-495-RUOTE-APERTO-600x900\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 600px; --smush-placeholder-aspect-ratio: 600/900;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"0\" data-end=\"592\">The <strong data-start=\"4\" data-end=\"17\">KOALA 495</strong> is an isothermal refrigerated container with an integrated cooling unit, ATP certification, and a capacity of 495 liters. Made from high-quality polyethylene and insulated with eco-friendly polyurethane foam free of CFCs and HCFCs, the KOALA 495 delivers excellent thermal performance combined with environmental sustainability. Its internal dimensions (600×400 mm) make it ideal for transporting boxes and trays, maximizing loading space in utility vehicles. Compliant with FD X 15-140 standards, it offers a reliable and flexible solution for professional transport needs.</p><ul data-start=\"594\" data-end=\"1067\" data-is-last-node=\"\" data-is-only-node=\"\"><li data-start=\"594\" data-end=\"622\"><p data-start=\"596\" data-end=\"622\"><strong data-start=\"596\" data-end=\"608\">Capacity</strong>: 495 liters</p></li><li data-start=\"623\" data-end=\"683\"><p data-start=\"625\" data-end=\"683\"><strong data-start=\"625\" data-end=\"637\">Material</strong>: Durable and highly insulating polyethylene</p></li><li data-start=\"684\" data-end=\"755\"><p data-start=\"686\" data-end=\"755\"><strong data-start=\"686\" data-end=\"700\">Insulation</strong>: Eco-friendly polyurethane foam (CFC- and HCFC-free)</p></li><li data-start=\"756\" data-end=\"833\"><p data-start=\"758\" data-end=\"833\"><strong data-start=\"758\" data-end=\"775\">Certification</strong>: ATP certified and compliant with FD X 15-140 standards</p></li><li data-start=\"834\" data-end=\"902\"><p data-start=\"836\" data-end=\"902\"><strong data-start=\"836\" data-end=\"856\">Practical design</strong>: Front-opening door for easy product access</p></li><li data-start=\"903\" data-end=\"981\"><p data-start=\"905\" data-end=\"981\"><strong data-start=\"905\" data-end=\"929\">Internal flexibility</strong>: 600×400 mm dimensions, ideal for boxes and trays</p></li><li data-start=\"982\" data-end=\"1067\" data-is-last-node=\"\"><p data-start=\"984\" data-end=\"1067\" data-is-last-node=\"\"><strong data-start=\"984\" data-end=\"1006\">Space optimization</strong>: Designed to maximize loading efficiency in utility vehicles</p></li></ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b80f4fb e-con-full e-flex e-con e-child\" data-id=\"b80f4fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9fc7267 elementor-widget elementor-widget-image\" data-id=\"9fc7267\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/haccp2.webp\" class=\"attachment-large size-large wp-image-2874 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-57b5a8b elementor-widget elementor-widget-image\" data-id=\"57b5a8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/riciclo2.webp\" class=\"attachment-large size-large wp-image-2875 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-dd60e38 elementor-widget elementor-widget-image\" data-id=\"dd60e38\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/atp2.webp\" class=\"attachment-large size-large wp-image-3058 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-54c0076 e-con-full e-flex e-con e-child\" data-id=\"54c0076\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-32056d2 elementor-align-center elementor-widget elementor-widget-button\" data-id=\"32056d2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA_495_contenitore_refrigerato_rev2-en-1.pdf\" target=\"_blank\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Data sheet</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t