EKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/576;\">\n\n<img decoding=\"async\" alt=\"K32AFISCZM0\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/K32AFISCZM0-768x576.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K32AFISCZM0.webp\"\n    data-title=\"K32AFISCZM0\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/576;\">\n\n<img decoding=\"async\" alt=\"KOALA-32F-FURGONE-1-1-1920x1440\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-32F-FURGONE-1-1-1920x1440-1-768x576.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-32F-FURGONE-1-1-1920x1440-1-1024x768.webp\"\n    data-title=\"KOALA-32F-FURGONE-1-1-1920x1440\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/576;\">\n\n<img decoding=\"async\" alt=\"ok_KOALA-32AF_DEF\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/ok_KOALA-32AF_DEF-768x432.jpeg\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/ok_KOALA-32AF_DEF-1024x576.jpeg\"\n    data-title=\"ok_KOALA-32AF_DEF\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/432;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"0\" data-end=\"179\">Ideal for the safe and reliable transport of temperature-sensitive products, the <strong data-start=\"81\" data-end=\"93\">Koala 32</strong> combines efficiency, durability, and practicality in a compact and functional design.</p><ul data-start=\"181\" data-end=\"840\" data-is-last-node=\"\" data-is-only-node=\"\"><li data-start=\"181\" data-end=\"300\"><p data-start=\"183\" data-end=\"300\"><strong data-start=\"183\" data-end=\"203\">Optimal capacity</strong>: 32 liters, perfect for transporting small to medium quantities of temperature-sensitive goods</p></li><li data-start=\"301\" data-end=\"501\"><p data-start=\"303\" data-end=\"501\"><strong data-start=\"303\" data-end=\"329\">High-quality materials</strong>: Made from durable polyethylene for long-lasting protection, with eco-friendly polyurethane foam insulation (CFC- and HCFC-free) that ensures excellent thermal retention</p></li><li data-start=\"502\" data-end=\"625\"><p data-start=\"504\" data-end=\"625\"><strong data-start=\"504\" data-end=\"525\">Dual power supply</strong>: Compatible with both 12Vdc and 230Vac, allowing flexible use on the go or in stationary settings</p></li><li data-start=\"626\" data-end=\"754\"><p data-start=\"628\" data-end=\"754\"><strong data-start=\"628\" data-end=\"649\">Functional design</strong>: Front-opening for easy and quick access, stackable for space optimization during transport or storage</p></li><li data-start=\"755\" data-end=\"840\" data-is-last-node=\"\"><p data-start=\"757\" data-end=\"840\" data-is-last-node=\"\"><strong data-start=\"757\" data-end=\"772\">Ease of use</strong>: Equipped with integrated handles for safe and comfortable carrying</p></li></ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b80f4fb e-con-full e-flex e-con e-child\" data-id=\"b80f4fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9fc7267 elementor-widget elementor-widget-image\" data-id=\"9fc7267\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/haccp2.webp\" class=\"attachment-large size-large wp-image-2874 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-57b5a8b elementor-widget elementor-widget-image\" data-id=\"57b5a8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/riciclo2.webp\" class=\"attachment-large size-large wp-image-2875 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-54c0076 e-con-full e-flex e-con e-child\" data-id=\"54c0076\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-32056d2 elementor-align-center elementor-widget elementor-widget-button\" data-id=\"32056d2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA_32AF_contenitore_refrigerato_rev2-en.pdf\" target=\"_blank\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Data sheet</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9444840 elementor-widget elementor-widget-html\" data-id=\"9444840\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\n\n#singlePage .post_title_wrapper .date {\n\n \n display: none !important;\n\n\n\n}\n\n</style>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-efe47fa e-flex e-con-boxed e-con e-parent\" data-id=\"efe47fa\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t",
