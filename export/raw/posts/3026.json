s://stathis.com.gr/wp-content/uploads/2025/06/KOALA-140-SU-CARRELLO-683x1024.webp\"\n    data-title=\"KOALA-140-SU-CARRELLO\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/1152;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Το KOALA 140 είναι ένα ισοθερμικό ψυκτικό δοχείο σχεδιασμένο για τη μεταφορά προϊόντων ελεγχόμενης θερμοκρασίας. Ο στοιβαζόμενος σχεδιασμός του το καθιστά πρακτικό και ιδανικό για τη βελτιστοποίηση του χώρου κατά τη μεταφορά και την αποθήκευση.</p><ul><li>Χωρητικότητα: 135 λίτρα.</li><li>Υλικό: Ανθεκτικό και ιδιαίτερα μονωτικό πολυαιθυλένιο.</li><li>Μόνωση: Οικολογικός αφρός πολυουρεθάνης (χωρίς CFC και HCFC).</li><li>Πρακτικός σχεδιασμός: Μπροστινό άνοιγμα για εύκολη και γρήγορη πρόσβαση στα προϊόντα.</li><li>Αρθρωτότητα: Στοιβαζόμενο για αποτελεσματική μεταφορά και αποθήκευση.</li><li>Εσωτερικές διαστάσεις: 600×400 mm.</li></ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<di