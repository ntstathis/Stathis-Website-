//stathis.com.gr/wp-content/uploads/2025/06/KOALA-500-CHIUSO-683x1024.webp\"\n    data-title=\"KOALA-500-CHIUSO\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/1152;\">\n\n<img decoding=\"async\" alt=\"K500AFTVCYM1\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/K500AFTVCYM1.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K500AFTVCYM1.webp\"\n    data-title=\"K500AFTVCYM1\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 741px; --smush-placeholder-aspect-ratio: 741/1000;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<article class=\"text-token-text-primary w-full\" dir=\"auto\" data-testid=\"conversation-turn-38\" data-scroll-anchor=\"true\"><div class=\"text-base my-auto mx-auto py-5 [--thread-content-margin:--spacing(4)] @[37rem]:[--thread-content-margin:--spacing(6)] @[72rem]:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)\"><div class=\"[--thread-content-max-width:32rem] @[34rem]:[--thread-content-max-width:40rem] @[64rem]:[--thread-content-max-width:48rem] mx-auto flex max-w-(--thread-content-max-width) flex-1 text-base gap-4 md:gap-5 lg:gap-6 group/turn-messages focus-visible:outline-hidden\" tabindex=\"-1\"><div class=\"group/conversation-turn relative flex w-full min-w-0 flex-col agent-turn\"><div class=\"relative flex-col gap-1 md:gap-3\"><div class=\"flex max-w-full flex-col grow\"><div class=\"min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-5\" dir=\"auto\" data-message-author-role=\"assistant\" data-message-id=\"803d2fe7-ebcf-4e2e-99a2-596881bfd8b9\" data-message-model-slug=\"gpt-4o\"><div class=\"flex w-full flex-col gap-1 empty:hidden first:pt-[3px]\"><div class=\"markdown prose dark:prose-invert w-full break-words light\"><p data-start=\"0\" data-end=\"189\">The <strong data-start=\"4\" data-end=\"17\">KOALA 500</strong> is a refrigerated insulated container designed for the safe and reliable transport of temperature-controlled products, ensuring maximum thermal efficiency and flexibility.</p><ul data-start=\"191\" data-end=\"899\" data-is-last-node=\"\" data-is-only-node=\"\"><li data-start=\"191\" data-end=\"274\"><p data-start=\"193\" data-end=\"274\"><strong data-start=\"193\" data-end=\"214\">Internal capacity</strong>: 500 liters, ideal for transporting fresh or frozen goods</p></li><li data-start=\"275\" data-end=\"377\"><p data-start=\"277\" data-end=\"377\"><strong data-start=\"277\" data-end=\"297\">Durable material</strong>: Made from robust, highly insulating polyethylene, suitable for intensive use</p></li><li data-start=\"378\" data-end=\"501\"><p data-start=\"380\" data-end=\"501\"><strong data-start=\"380\" data-end=\"402\">Thermal insulation</strong>: Eco-friendly polyurethane foam, free of CFCs and HCFCs, providing excellent thermal performance</p></li><li data-start=\"502\" data-end=\"625\"><p data-start=\"504\" data-end=\"625\"><strong data-start=\"504\" data-end=\"525\">Internal adapters</strong>: Stainless steel guides designed to accommodate GN containers, ensuring optimal load organization</p></li><li data-start=\"626\" data-end=\"797\"><p data-start=\"628\" data-end=\"651\"><strong data-start=\"628\" data-end=\"648\">Available models</strong>:</p><ul data-start=\"654\" data-end=\"797\"><li data-start=\"654\" data-end=\"724\"><p data-start=\"656\" data-end=\"724\">Version with top-mounted cooling unit (roof-mounted refrigeration)</p></li><li data-start=\"727\" data-end=\"797\"><p data-start=\"729\" data-end=\"797\">Version with rear-mounted cooling unit (rear refrigeration system)</p></li></ul></li><li data-start=\"798\" data-end=\"899\" data-is-last-node=\"\"><p data-start=\"800\" data-end=\"899\" data-is-last-node=\"\"><strong data-start=\"800\" data-end=\"823\">Internal dimensions</strong>: Compatible with GN 1/1 containers, allowing for efficient space management</p></li></ul></div></div></div></div><div class=\"flex min-h-[46px] justify-start\"> </div></div><div class=\"aria-live=polite absolute\"><div class=\"flex items-center justify-center\"> </div></div></div></div></div></article><div class=\"pointer-events-none h-px w-px\" aria-hidden=\"true\" data-edge=\"true\"> </div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b80f4fb e-con-full e-flex e-con e-child\" data-id=\"b80f4fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9fc7267 elementor-widget elementor-widget-image\" data-id=\"9fc7267\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"