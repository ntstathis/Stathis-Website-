    "rendered": "\t\t<div data-elementor-type=\"wp-post\" data-elementor-id=\"4378\" class=\"elementor elementor-4378\" data-elementor-post-type=\"post\">\n\t\t\t\t<div class=\"elementor-element elementor-element-1ac7e03 e-flex e-con-boxed e-con e-parent\" data-id=\"1ac7e03\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-7557bfa elementor-widget elementor-widget-ucaddon_uc_compact_image_theme\" data-id=\"7557bfa\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_uc_compact_image_theme.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Compact Gallery -->\n\t\t<link id='font-awesome-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/font-awesome6/fontawesome-all.min.css' type='text/css' rel='stylesheet' >\n\t\t<link id='font-awesome-4-shim-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/font-awesome6/fontawesome-v4-shims.min.css' type='text/css' rel='stylesheet' >\n\t\t<link id='unitegallery-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/unitegallery/css/unite-gallery.css' type='text/css' rel='stylesheet' >\n\n<style>/* widget: Compact Gallery */\n\n#uc_uc_compact_image_theme_elementor_7557bfa-wrapper{\n  min-height: 1px;\n}\n\n#uc_uc_compact_image_theme_elementor_7557bfa{\n  margin:0 auto;\n  display: none;\n}\n\n</style>\n\n<div id=\"uc_uc_compact_image_theme_elementor_7557bfa-wrapper\">\n  <div id=\"uc_uc_compact_image_theme_elementor_7557bfa\" class=\"uc-items-wrapper  \"  data-remote-type=\"gallery\" data-custom-sethtml=\"true\" >\n    \n<img decoding=\"async\" alt=\"K1000AFTVDZM1K1000AFTVCZM1K1000AFTVDYM1K1000AFTVCYM1-1\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/K1000AFTVDZM1K1000AFTVCZM1K1000AFTVDYM1K1000AFTVCYM1-1-768x768.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K1000AFTVDZM1K1000AFTVCZM1K1000AFTVDYM1K1000AFTVCYM1-1-1024x1024.webp\"\n    data-title=\"K1000AFTVDZM1K1000AFTVCZM1K1000AFTVDYM1K1000AFTVCYM1-1\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/768;\">\n\n<img decoding=\"async\" alt=\"K1000AFTVDYM1-600x763\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/K1000AFTVDYM1-600x763-1.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K1000AFTVDYM1-600x763-1.webp\"\n    data-title=\"K1000AFTVDYM1-600x763\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 600px; --smush-placeholder-aspect-ratio: 600/763;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"0\" data-end=\"141\">The <strong data-start=\"4\" data-end=\"18\">Koala 1000</strong> is the ideal isothermal refrigerated container for the safe and professional transport of temperature-controlled products.</p>\n<ul data-start=\"143\" data-end=\"1000\" data-is-last-node=\"\" data-is-only-node=\"\">\n<li data-start=\"143\" data-end=\"255\">\n<p data-start=\"145\" data-end=\"255\"><strong data-start=\"145\" data-end=\"163\">Large capacity</strong>: 830 liters, perfect for transporting high volumes while maintaining optimal temperatures</p>\n</li>\n<li data-start=\"256\" data-end=\"518\">\n<p data-start=\"258\" data-end=\"518\"><strong data-start=\"258\" data-end=\"281\">Robust construction</strong>: Made from durable polyethylene and insulated with eco-friendly polyurethane foam, free of CFCs and HCFCs, ensuring excellent thermal retention, preserving the organoleptic properties of food, and reducing the risk of bacterial growth</p>\n</li>\n<li data-start=\"519\" data-end=\"700\">\n<p data-start=\"521\" data-end=\"700\"><strong data-start=\"521\" data-end=\"545\">Optimized dimensions</strong>: Compliant with EUROPALLET standards (80×120 cm), allowing efficient use of loading space in utility vehicles and improving overall transport efficiency</p>\n</li>\n<li data-start=\"701\" data-end=\"876\">\n<p data-start=\"703\" data-end=\"876\"><strong data-start=\"703\" data-end=\"724\">Advanced security</strong>: Equipped with a stainless steel closing handle with a release button and pre-fitted for a tamper-evident system, ensuring maximum transport security</p>\n</li>\n<li data-start=\"877\" data-end=\"1000\" data-is-last-node=\"\">\n<p data-start=\"879\" data-end=\"1000\" data-is-last-node=\"\"><strong data-start=\"879\" data-end=\"900\">Dual power supply</strong>: Compatible with 12Vdc and 230Vac, offering maximum flexibility for both transit and stationary use</p>\n</li>\n</ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b80f4fb e-con-full e-flex e-con e-child\" data-id=\"b80f4fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9fc7267 elementor-widget elementor-widget-image\" data-id=\"9fc7267\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/haccp2.webp\" class=\"attachment-large size-large wp-image-2874 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-57b5a8b elementor-widget elementor-widget-image\" data-id=\"57b5a8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/riciclo2.webp\" class=\"attachment-large size-large wp-image-2875 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-54c0076 e-con-full e-flex e-con e-child\" data-id=\"54c0076\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-32056d2 elementor-align-center elementor-widget elementor-widget-button\" data-id=\"32056d2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">