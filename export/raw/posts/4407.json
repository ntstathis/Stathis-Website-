td>✔ Gear shift point indicator</td>\n</tr>\n<tr>\n<td>✔ Speedometer in km/h</td>\n<td>✔ Mercedes-Benz MobiloVan with DSB &#038; warranty extension</td>\n</tr>\n<tr>\n<td>✔ Improved tire wear</td>\n<td>✔ Semi-automatic air conditioning TEMPMATIC</td>\n</tr>\n<tr>\n<td>✔ Chassis with cab</td>\n<td>✔ Rear underrun protection (EU)</td>\n</tr>\n<tr>\n<td>✔ Tires 235/65 R16</td>\n<td>✔ Outside temperature display</td>\n</tr>\n<tr>\n<td>✔ Basic</td>\n<td>✔ Basic version</td>\n</tr>\n<tr>\n<td>✔ Technical modifications</td>\n<td>✔ AGM battery 12 V 92 Ah</td>\n</tr>\n<tr>\n<td>✔ Start assist – contact</td>\n<td>✔ Left-hand drive</td>\n</tr>\n<tr>\n<td>✔ Model generation 0</td>\n<td>✔ Shelf above front windshield</td>\n</tr>\n<tr>\n<td>✔ Heated and electrically adjustable exterior mirror</td>\n<td>✔ Passenger seat</td>\n</tr>\n<tr>\n<td>✔ Alternator 14 V / 200 A</td>\n<td>✔ Weight from 3.5 t to 3.2 t</td>\n</tr>\n<tr>\n<td>✔ Passenger seatbelt warning system</td>\n<td>✔ High-beam assist</td>\n</tr>\n<tr>\n<td>✔ Spare wheel mount under the rear of the chassis</td>\n<td>✔ Spare wheel</td>\n</tr>\n<tr>\n<td>✔ Hydraulic jack</td>\n<td>✔ Armrest on driver’s seat</td>\n</tr>\n<tr>\n<td>✔ Factory control code 065</td>\n<td>✔ Driver airbag</td>\n</tr>\n<tr>\n<td>✔ Modification package &#8216;3 &#8211; I&#8217;</td>\n<td>✔ Noise reduction measures</td>\n</tr>\n<tr>\n<td>✔ Reinforcement before paneling</td>\n<td>✔ Manuals in Greek</td>\n</tr>\n<tr>\n<td>✔ Export code</td>\n<td>✔ Steel rim 6.5Jx16</td>\n</tr>\n<tr>\n<td>✔ ECO start-stop function</td>\n<td>✔ Driver’s seat</td>\n</tr>\n<tr>\n<td>✔ Rear axle NCV3, crown wheel 215</td>\n<td>✔ 6-speed gearbox ECO Gear 360</td>\n</tr>\n<tr>\n<td>✔ Complete vehicle</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</details>\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-2111\" class=\"e-n-accordion-item\">\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"2\" tabindex=\"-1\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-2111\">\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> Warranty </div></span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n\t\t</span>\n\n\t\t\t\t\t\t</summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-2111\" class=\"elementor-element elementor-element-6dfd301 e-con-full e-flex e-con e-child\" data-id=\"6dfd301\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-2111\" class=\"elementor-element elementor-element-eda29c7 e-flex e-con-boxed e-con e-child\" data-id=\"eda29c7\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-4798d0d elementor-widget elementor-widget-text-editor\" data-id=\"4798d0d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>A) <strong data-start=\"3\" data-end=\"29\" data-is-last-node=\"\">Coverage from day one.</strong></p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-75f077b elementor-widget elementor-widget-text-editor\" data-id=\"75f077b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"0\" data-end=\"217\">All new Mercedes-Benz vehicles come with a <strong data-start=\"43\" data-end=\"76\">two-year new vehicle warranty</strong>. This warranty is offered in addition to the statutory liability for material defects and provides peace of mind during the first two years.</p>\n<p data-start=\"219\" data-end=\"367\">The warranty is valid from the date of vehicle delivery or the date of first registration, whichever comes first, and has <strong data-start=\"341\" data-end=\"366\">no mileage limitation</strong>.</p>\n<p data-start=\"369\" data-end=\"580\" data-is-last-node=\"\" data-is-only-node=\"\">The contractual warranty is provided by the <strong data-start=\"413\" data-end=\"439\">Authorized Distributor</strong> who completes the sale. It is recognized in all <strong data-start=\"488\" data-end=\"508\">EU member states</strong>, as well as in <strong data-start=\"524\" data-end=\"558\">Iceland, Liechtenstein, Norway</strong>, and <strong data-start=\"564\" data-end=\"579\">Switzerland</strong>.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-2111\" class=\"elementor-element elementor-element-154472d e-flex e-con-boxed e-con e-child\" data-id=\"154472d\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-61d049b elementor-widget elementor-widget-text-editor\" data-id=\"61d049b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>B) <strong data-start=\"3\" data-end=\"36\">The Electric Vehicle Warranty</strong></p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1ace72d elementor-widget elementor-widget-text-editor\" data-id=\"1ace72d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<article class=\"text-token-text-primary w-full\" dir=\"auto\" data-testid=\"conversation-turn-98\" data-scroll-anchor=\"true\">\n<div class=\"text-base my-auto mx-auto py-5 [--thread-content-margin:--spacing(4)] @[37rem]:[--thread-content-margin:--spacing(6)] @[72rem]:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)\">\n<div class=\"[--thread-content-max-width:32rem] @[34rem]:[--thread-content-max-width:40rem] @[64rem]:[--thread-content-max-width:48rem] mx-auto flex max-w-(--thread-content-max-width) flex-1 text-base gap-4 md:gap-5 lg:gap-6 group/turn-messages focus-visible:outline-hidden\" tabindex=\"-1\">\n<div class=\"group/conversation-turn relative flex w-full min-w-0 flex-col agent-turn\">\n<div class=\"relative flex-col gap-1 md:gap-3\">\n<div class=\"flex max-w-full flex-col grow\">\n<div class=\"min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-5\" dir=\"auto\" data-message-author-role=\"assistant\" data-message-id=\"b09b1be8-856f-433e-9dd9-67a047206bbb\" data-message-model-slug=\"gpt-4o\">\n<div class=\"flex w-full flex-col gap-1 empty:hidden first:pt-[3px]\">\n<div class=\"markdown prose dark:prose-invert w-full break-words light\">\n<p data-start=\"0\" data-end=\"209\">All electric vehicles come with a <strong data-start=\"34\" data-end=\"53\">2-year warranty</strong> with <strong data-start=\"59\" data-end=\"84\">no mileage limitation</strong>, covering both mechanical and electrical components (e.g. suspension, steering system, switches, infotainment system, etc.).</p>\n<p data-start=\"211\" data-end=\"596\" data-is-last-node=\"\" data-is-only-node=\"\">In addition to the standard 2-year warranty for the electric vehicle, a <strong data-start=\"283\" data-end=\"306\">battery certificate</strong> is also provided. This guarantees warranty coverage through <strong data-start=\"367\" data-end=\"420\">repair or replacement of the high-voltage battery</strong> in the event of malfunction, for a period of <strong data-start=\"466\" data-end=\"491\">8 years or 160,000 km</strong>—whichever comes first—or if the battery’s <strong data-start=\"534\" data-end=\"595\">maximum capacity falls below 70% of its original capacity</strong>.</p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"flex min-h-[46px] justify-start\"> </div>\n</div>\n<div class=\"aria-live=polite absolute\">\n<div class=\"flex items-center justify-center\"> </div>\n</div>\n</div>\n</div>\n</div>\n</article>\n<div class=\"pointer-events-none h-px w-px\" aria-hidden=\"true\" data-edge=\"true\"> </div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</details>\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-2112\" class=\"e-n-accordion-item\">\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"3\" tabindex=\"-1\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-2112\">\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> Documents </div></span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n\t\t</span>\n\n\t\t\t\t\t\t</summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-2112\" class=\"elementor-element elementor-element-15ebdba e-con-full e-flex e-con e-child\" data-id=\"15ebdba\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-628baaa elementor-align-center elementor-widget elementor-widget-button\" data-id=\"628baaa\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https://stathis.com.gr/wp-content/uploads/2025/07/MercedesBenzGreeceVansModified_19738364_1.0.pdf\" target=\"_blank\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Data sheet</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-f643bed elementor-widget elementor-widget-html\" data-id=\"f643bed\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\n\n#singlePage .post_title_wrapper .date {\n\n \n display: none !important;\n\n\n\n}\n\n</style>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</details>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element