ISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0M0-1.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0M0-1.webp\"\n    data-title=\"K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0M0-1\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 743px; --smush-placeholder-aspect-ratio: 743/743;\">\n\n<img decoding=\"async\" alt=\"K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0-2\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0-2-768x766.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0-2.webp\"\n    data-title=\"K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0-2\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/766;\">\n\n<img decoding=\"async\" alt=\"K50ASISBZM0\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/K50ASISBZM0.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K50ASISBZM0.webp\"\n    data-title=\"K50ASISBZM0\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 667px; --smush-placeholder-aspect-ratio: 667/1000;\">\n\n<img decoding=\"async\" alt=\"KOALA-50\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-50-768x511.jpg\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-50-1024x682.jpg\"\n    data-title=\"KOALA-50\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/511;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"0\" data-end=\"118\">The <strong data-start=\"4\" data-end=\"16\">Koala 50</strong> is the ideal mobile refrigerated container for the safe transport of temperature-controlled products.</p><ul data-start=\"120\" data-end=\"914\" data-is-last-node=\"\" data-is-only-node=\"\"><li data-start=\"120\" data-end=\"332\"><p data-start=\"122\" data-end=\"332\"><strong data-start=\"122\" data-end=\"145\">Robust construction</strong>: Made with CFC- and HCFC-free materials, ensuring excellent thermal performance, preserving the organoleptic properties of transported goods, and reducing the risk of bacterial growth.</p></li><li data-start=\"333\" data-end=\"449\"><p data-start=\"335\" data-end=\"449\"><strong data-start=\"335\" data-end=\"355\">Optimal capacity</strong>: 53 liters, ideal for transporting laboratory samples or other temperature-sensitive items.</p></li><li data-start=\"450\" data-end=\"547\"><p data-start=\"452\" data-end=\"547\"><strong data-start=\"452\" data-end=\"474\">Integrated handles</strong>: Practical stainless steel handles for secure grip and easy transport.</p></li><li data-start=\"548\" data-end=\"700\"><p data-start=\"550\" data-end=\"700\"><strong data-start=\"550\" data-end=\"573\">Internal protection</strong>: Equipped with an evaporator protection grid made of plastic-coated metal wire, ensuring safety and long-lasting durability.</p></li><li data-start=\"701\" data-end=\"784\"><p data-start=\"703\" data-end=\"784\"><strong data-start=\"703\" data-end=\"723\">Practical design</strong>: Top-opening lid for simple and direct access to contents.</p></li><li data-start=\"785\" data-end=\"914\" data-is-last-node=\"\"><p data-start=\"787\" data-end=\"914\" data-is-last-node=\"\"><strong data-start=\"787\" data-end=\"808\">Dual power supply</strong>: Compatible with 12Vdc and 230Vac, offering flexible use both on the move and in stationary environments.</p></li></ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b80f4fb e-con-full e-flex e-con e-child\" data-id=\"b80f4fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9fc7267 elementor-widget elementor-widget-image\" data-id=\"9fc7267\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/haccp2.webp\" class=\"attachment-large size-large wp-image-2874 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-57b5a8b elementor-widget elementor-widget-image\" data-id=\"57b5a8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/riciclo2.webp\" class=\"attachment-large size-large wp-image-2875 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-54c0076 e-con-full e-flex e-con e-child\" data-id=\"54c0076\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-32056d2 elementor-align-center elementor-widget elementor-widget-button\" data-id=\"32056d2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA_50_contenitore_refrigerato_rev2-en.pdf\" target=\"_blank\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Data sheet</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9444840 elementor-widget elementor-widget-html\" data-id=\"9444840\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\n\n#singlePage .post_title_wrapper .date {\n\n \n display: none !important;\n\n\n\n}\n\n</style>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t",
