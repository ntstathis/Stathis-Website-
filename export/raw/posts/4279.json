    "rendered": "\t\t<div data-elementor-type=\"wp-post\" data-elementor-id=\"4279\" class=\"elementor elementor-4279\" data-elementor-post-type=\"post\">\n\t\t\t\t<div class=\"elementor-element elementor-element-ee7dc04 e-flex e-con-boxed e-con e-parent\" data-id=\"ee7dc04\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-1233be4 elementor-widget elementor-widget-ucaddon_uc_compact_image_theme\" data-id=\"1233be4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_uc_compact_image_theme.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Compact Gallery -->\n\t\t<link id='font-awesome-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/font-awesome6/fontawesome-all.min.css' type='text/css' rel='stylesheet' >\n\t\t<link id='font-awesome-4-shim-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/font-awesome6/fontawesome-v4-shims.min.css' type='text/css' rel='stylesheet' >\n\t\t<link id='unitegallery-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/unitegallery/css/unite-gallery.css' type='text/css' rel='stylesheet' >\n\n<style>/* widget: Compact Gallery */\n\n#uc_uc_compact_image_theme_elementor_1233be4-wrapper{\n  min-height: 1px;\n}\n\n#uc_uc_compact_image_theme_elementor_1233be4{\n  margin:0 auto;\n  display: none;\n}\n\n</style>\n\n<div id=\"uc_uc_compact_image_theme_elementor_1233be4-wrapper\">\n  <div id=\"uc_uc_compact_image_theme_elementor_1233be4\" class=\"uc-items-wrapper  \"  data-remote-type=\"gallery\" data-custom-sethtml=\"true\" >\n    \n<img decoding=\"async\" alt=\"GK780AFTVDZM1GK780AFTVCZM1GK780AFTVDYM1GK780AFTVCYM1\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/GK780AFTVDZM1GK780AFTVCZM1GK780AFTVDYM1GK780AFTVCYM1-768x768.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/GK780AFTVDZM1GK780AFTVCZM1GK780AFTVDYM1GK780AFTVCYM1-1024x1024.webp\"\n    data-title=\"GK780AFTVDZM1GK780AFTVCZM1GK780AFTVDYM1GK780AFTVCYM1\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/768;\">\n\n<img decoding=\"async\" alt=\"GK780AFTVDZM1GK780AFTVCZM1GK780AFTVDYM1GK780AFTVCYM1-1\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/GK780AFTVDZM1GK780AFTVCZM1GK780AFTVDYM1GK780AFTVCYM1-1-1-768x768.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/GK780AFTVDZM1GK780AFTVCZM1GK780AFTVDYM1GK780AFTVCYM1-1-1-1024x1024.webp\"\n    data-title=\"GK780AFTVDZM1GK780AFTVCZM1GK780AFTVDYM1GK780AFTVCYM1-1\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/768;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"0\" data-end=\"362\">The <strong data-start=\"4\" data-end=\"24\">Koala Green 1000</strong> refrigerated container is a self-powered isothermal cooling unit. It is equipped with an integrated battery that ensures autonomous operation. The battery can be recharged either by connecting the container to a standard 230Vac power supply or by removing it from the cooling unit and connecting it to a dedicated external power adapter.</p><ul data-start=\"364\" data-end=\"753\" data-is-last-node=\"\" data-is-only-node=\"\"><li data-start=\"364\" data-end=\"452\"><p data-start=\"366\" data-end=\"452\"><strong data-start=\"366\" data-end=\"378\">Capacity</strong>: 830 liters, with a front-opening door for convenient and quick access.</p></li><li data-start=\"453\" data-end=\"602\"><p data-start=\"455\" data-end=\"602\"><strong data-start=\"455\" data-end=\"481\">Construction materials</strong>: Made of polyethylene and insulated with CFC- and HCFC-free polyurethane foam, providing excellent thermal insulation.</p></li><li data-start=\"603\" data-end=\"753\" data-is-last-node=\"\"><p data-start=\"605\" data-end=\"753\" data-is-last-node=\"\"><strong data-start=\"605\" data-end=\"619\">Dimensions</strong>: Compatible with the EUROPALLET standard (80×120 cm), allowing for optimal space management and a perfect fit in commercial vehicles.</p></li></ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b80f4fb e-con-full e-flex e-con e-child\" data-id=\"b80f4fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9fc7267 elementor-widget elementor-widget-image\" data-id=\"9fc7267\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/haccp2.webp\" class=\"attachment-large size-large wp-image-2874 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-57b5a8b elementor-widget elementor-widget-image\" data-id=\"57b5a8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/riciclo2.webp\" class=\"attachment-large size-large wp-image-2875 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-54c0076 e-con-full e-flex e-con e-child\" data-id=\"54c0076\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-32056d2 elementor-align-center elementor-widget elementor-widget-button\" data-id=\"32056d2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA_GREEN_1000_contenitore_refrigerato_rev2-en.pdf\" target=\"_blank\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Data sheet</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9444840 elementor-widget elementor-widget-html\" data-id=\"9444840\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\n\n#singlePage .post_title_wrapper .date {\n\n \n display: none !important;\n\n\n\n}\n\n</style>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t",
