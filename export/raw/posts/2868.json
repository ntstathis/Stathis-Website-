/stathis.com.gr/wp-content/uploads/2025/06/KOALA-20-scaled-1-1024x683.webp\"\n    data-title=\"KOALA-20-scaled\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/512;\">\n\n<img decoding=\"async\" alt=\"KOALA-20-MOTO-scaled\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-20-MOTO-scaled-1-768x1152.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-20-MOTO-scaled-1-683x1024.webp\"\n    data-title=\"KOALA-20-MOTO-scaled\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/1152;\">\n\n<img decoding=\"async\" alt=\"KOALA-20-APERTO-600x400\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-20-APERTO-600x400-1.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-20-APERTO-600x400-1.webp\"\n    data-title=\"KOALA-20-APERTO-600x400\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 600px; --smush-placeholder-aspect-ratio: 600/400;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Συμπαγές κινητό ψυγείο, ιδανικό για την ασφαλή μεταφορά προϊόντων ελεγχόμενης θερμοκρασίας.</p><ul><li>Χωρητικότητα: 21 λίτρα, ιδανικό για μικρές και ειδικές ανάγκες μεταφοράς.</li><li>Ενσωματωμένες λαβές: Βολικές λαβές ενσωματωμένες στο σώμα του δοχείου για εύκολη και ασφαλή μεταφορά.</li><li>Εσωτερική προστασία: Εξοπλισμένο με εσωτερικό προστατευτικό πλέγμα για τον εξατμιστή, κατασκευασμένο από μεταλλικό σύρμα με πλαστική επικάλυψη, που εξασφαλίζει ανθεκτικότητα και ασφάλεια.</li><li>Διπλή τροφοδοσία: Συμβατό με πηγές τροφοδοσίας 12Vdc και 230Vac, προσφέροντας μέγιστη ευελιξία για χρήση εν κινήσει και από σταθερή θέση.</li><li>Ενσωματωμένη μονάδα ψύξης: &#8216;Ενα στατικό σύστημα για αποτελεσματική και ομοιόμορφη ψύξη.</li></ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b80f4fb e-con-full e-flex e-con e-child\" data-id=\"b80f4fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9fc7267 elementor-widget elementor-widget-image\" data-id=\"9fc7267\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/haccp2.webp\" class=\"attachment-large size-large wp-image-2874 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-