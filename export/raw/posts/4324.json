    "rendered": "\t\t<div data-elementor-type=\"wp-post\" data-elementor-id=\"4324\" class=\"elementor elementor-4324\" data-elementor-post-type=\"post\">\n\t\t\t\t<div class=\"elementor-element elementor-element-159a092 e-flex e-con-boxed e-con e-parent\" data-id=\"159a092\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-af7730b elementor-widget elementor-widget-ucaddon_uc_compact_image_theme\" data-id=\"af7730b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"ucaddon_uc_compact_image_theme.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!-- start Compact Gallery -->\n\t\t<link id='font-awesome-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/font-awesome6/fontawesome-all.min.css' type='text/css' rel='stylesheet' >\n\t\t<link id='font-awesome-4-shim-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/font-awesome6/fontawesome-v4-shims.min.css' type='text/css' rel='stylesheet' >\n\t\t<link id='unitegallery-css' href='https://stathis.com.gr/wp-content/plugins/unlimited-elements-for-elementor-premium/assets_libraries/unitegallery/css/unite-gallery.css' type='text/css' rel='stylesheet' >\n\n<style>/* widget: Compact Gallery */\n\n#uc_uc_compact_image_theme_elementor_af7730b-wrapper{\n  min-height: 1px;\n}\n\n#uc_uc_compact_image_theme_elementor_af7730b{\n  margin:0 auto;\n  display: none;\n}\n\n</style>\n\n<div id=\"uc_uc_compact_image_theme_elementor_af7730b-wrapper\">\n  <div id=\"uc_uc_compact_image_theme_elementor_af7730b\" class=\"uc-items-wrapper  \"  data-remote-type=\"gallery\" data-custom-sethtml=\"true\" >\n    \n<img decoding=\"async\" alt=\"Koala_70-1\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/Koala_70-1-768x768.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/Koala_70-1-1024x1024.webp\"\n    data-title=\"Koala_70-1\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/768;\">\n\n<img decoding=\"async\" alt=\"K70AFDSDZM0K70AFTSDZM0K70AFDSDYM0K70AFTSDYM0-2\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/K70AFDSDZM0K70AFTSDZM0K70AFDSDYM0K70AFTSDYM0-2-768x768.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K70AFDSDZM0K70AFTSDZM0K70AFDSDYM0K70AFTSDYM0-2-1024x1024.webp\"\n    data-title=\"K70AFDSDZM0K70AFTSDZM0K70AFDSDYM0K70AFTSDYM0-2\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/768;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"0\" data-end=\"466\">The <strong data-start=\"4\" data-end=\"16\">KOALA 70</strong> is an isothermal refrigerated container designed for the transport of temperature-controlled products. With a capacity of 68 liters and GN 1/1 internal dimensions, it ensures excellent thermal retention, preserving the organoleptic properties of food and reducing the risk of bacterial growth. Made from high-quality polyethylene and insulated with CFC- and HCFC-free polyurethane foam, it delivers high performance with respect for the environment.</p><ul data-start=\"468\" data-end=\"871\" data-is-last-node=\"\" data-is-only-node=\"\"><li data-start=\"468\" data-end=\"495\"><p data-start=\"470\" data-end=\"495\"><strong data-start=\"470\" data-end=\"482\">Capacity</strong>: 68 liters</p></li><li data-start=\"496\" data-end=\"556\"><p data-start=\"498\" data-end=\"556\"><strong data-start=\"498\" data-end=\"510\">Material</strong>: Durable and highly insulating polyethylene</p></li><li data-start=\"557\" data-end=\"631\"><p data-start=\"559\" data-end=\"631\"><strong data-start=\"559\" data-end=\"573\">Insulation</strong>: Eco-friendly polyurethane foam, free of CFCs and HCFCs</p></li><li data-start=\"632\" data-end=\"696\"><p data-start=\"634\" data-end=\"696\"><strong data-start=\"634\" data-end=\"650\">Smart design</strong>: Front-opening door for easy product access</p></li><li data-start=\"697\" data-end=\"782\"><p data-start=\"699\" data-end=\"782\"><strong data-start=\"699\" data-end=\"713\">Modularity</strong>: Stackable and compatible with multi-temperature transport systems</p></li><li data-start=\"783\" data-end=\"871\" data-is-last-node=\"\"><p data-start=\"785\" data-end=\"871\" data-is-last-node=\"\"><strong data-start=\"785\" data-end=\"800\">Versatility</strong>: GN 1/1 internal dimensions, suitable for a wide range of applications</p></li></ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b80f4fb e-con-full e-flex e-con e-child\" data-id=\"b80f4fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9fc7267 elementor-widget elementor-widget-image\" data-id=\"9fc7267\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/haccp2.webp\" class=\"attachment-large size-large wp-image-2874 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-57b5a8b elementor-widget elementor-widget-image\" data-id=\"57b5a8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/riciclo2.webp\" class=\"attachment-large size-large wp-image-2875 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-54c0076 e-con-full e-flex e-con e-child\" data-id=\"54c0076\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-32056d2 elementor-align-center elementor-widget elementor-widget-button\" data-id=\"32056d2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA_70_contenitore_refrigerato_rev1-en.pdf\" target=\"_blank\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Data sheet</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9444840 elementor-widget elementor-widget-html\" data-id=\"9444840\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\n\n#singlePage .post_title_wrapper .date {\n\n \n display: none !important;\n\n\n\n}\n\n</style>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t",
