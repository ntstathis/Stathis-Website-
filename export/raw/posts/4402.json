/td>\n</tr>\n<tr>\n<td>✔ Height and tilt adjustable steering wheel</td>\n<td>✔ Oil change interval 30,000 / 40,000 km</td>\n</tr>\n<tr>\n<td>✔ Mercedes-Benz MobiloVan with DSB &#038; warranty extension</td>\n<td>✔ Semi-automatic air conditioning TEMPMATIC</td>\n</tr>\n<tr>\n<td>✔ Rear underride guard (EU)</td>\n<td>✔ Outside temperature display</td>\n</tr>\n<tr>\n<td>✔ Basic version</td>\n<td>✔ AGM battery 12 V 92 Ah</td>\n</tr>\n<tr>\n<td>✔ Left-hand drive</td>\n<td>✔ Shelf above windshield</td>\n</tr>\n<tr>\n<td>✔ Weight from 3.5 t to 3.2 t</td>\n<td>✔ High-beam assist</td>\n</tr>\n<tr>\n<td>✔ Lockable glove compartment lid</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</details>\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-2111\" class=\"e-n-accordion-item\">\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"2\" tabindex=\"-1\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-2111\">\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> Warranty </div></span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n\t\t</span>\n\n\t\t\t\t\t\t</summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-2111\" class=\"elementor-element elementor-element-6dfd301 e-con-full e-flex e-con e-child\" data-id=\"6dfd301\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-2111\" class=\"elementor-element elementor-element-eda29c7 e-flex e-con-boxed e-con e-child\" data-id=\"eda29c7\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-4798d0d elementor-widget elementor-widget-text-editor\" data-id=\"4798d0d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>A) Coverage from day one.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-75f077b elementor-widget elementor-widget-text-editor\" data-id=\"75f077b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"0\" data-end=\"212\">All new Mercedes-Benz vehicles come with a <strong data-start=\"43\" data-end=\"76\">two-year new vehicle warranty</strong>. This warranty is provided in addition to the legal liability for material defects and offers peace of mind during the first two years.</p><p data-start=\"214\" data-end=\"359\">The warranty is valid from the date of vehicle delivery or the date of first registration, whichever comes first, with <strong data-start=\"333\" data-end=\"358\">no mileage limitation</strong>.</p><p data-start=\"361\" data-end=\"580\" data-is-last-node=\"\" data-is-only-node=\"\">The contractual warranty is provided by the <strong data-start=\"405\" data-end=\"426\">Authorized Dealer</strong> who carries out the sale. It is recognized in all member states of the European Union, as well as in <strong data-start=\"528\" data-end=\"579\">Iceland, Liechtenstein, Norway, and Switzerland</strong>.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-2111\" class=\"elementor-element elementor-element-154472d e-flex e-con-boxed e-con e-child\" data-id=\"154472d\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-61d049b elementor-widget elementor-widget-text-editor\" data-id=\"61d049b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<article class=\"text-token-text-primary w-full\" dir=\"auto\" data-testid=\"conversation-turn-74\" data-scroll-anchor=\"true\"><div class=\"text-base my-auto mx-auto py-5 [--thread-content-margin:--spacing(4)] @[37rem]:[--thread-content-margin:--spacing(6)] @[72rem]:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)\"><div class=\"[--thread-content-max-width:32rem] @[34rem]:[--thread-content-max-width:40rem] @[64rem]:[--thread-content-max-width:48rem] mx-auto flex max-w-(--thread-content-max-width) flex-1 text-base gap-4 md:gap-5 lg:gap-6 group/turn-messages focus-visible:outline-hidden\" tabindex=\"-1\"><div class=\"group/conversation-turn relative flex w-full min-w-0 flex-col agent-turn\"><div class=\"relative flex-col gap-1 md:gap-3\"><div class=\"flex max-w-full flex-col grow\"><div class=\"min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-5\" dir=\"auto\" data-message-author-role=\"assistant\" data-message-id=\"ef98b184-33c2-4b4d-870e-789d0e3492c6\" data-message-model-slug=\"gpt-4o\"><div class=\"flex w-full flex-col gap-1 empty:hidden first:pt-[3px]\"><div class=\"markdown prose dark:prose-invert w-full break-words light\"><p data-start=\"0\" data-end=\"36\" data-is-last-node=\"\" data-is-only-node=\"\">B) <strong data-start=\"3\" data-end=\"36\" data-is-last-node=\"\">The Electric Vehicle Warranty</strong></p></div></div></div></div></div></div></div></div></article><div class=\"pointer-events-none h-px w-px\" aria-hidden=\"true\" data-edge=\"true\"> </div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1ace72d elementor-widget elementor-widget-text-editor\" data-id=\"1ace72d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"0\" data-end=\"198\">Electric vehicles come with a <strong data-start=\"30\" data-end=\"49\">2-year warranty</strong> with <strong data-start=\"55\" data-end=\"80\">no mileage limitation</strong>, covering both mechanical and electrical components (e.g. suspension, steering system, switches, infotainment, etc.).</p><p data-start=\"200\" data-end=\"566\" data-is-last-node=\"\" data-is-only-node=\"\">In addition to the standard 2-year warranty, an <strong data-start=\"248\" data-end=\"280\">electric battery certificate</strong> is also provided. This ensures warranty coverage through <strong data-start=\"338\" data-end=\"391\">replacement or repair of the high-voltage battery</strong> in the event of malfunction for a period of <strong data-start=\"436\" data-end=\"461\">8 years or 160,000 km</strong>—whichever comes first—or if the battery’s maximum capacity falls below <strong data-start=\"533\" data-end=\"565\">70% of its original capacity</strong>.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</details>\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-2112\" class=\"e-n-accordion-item\">\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"3\" tabindex=\"-1\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-2112\">\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> Documents </div></span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n\t\t</span>\n\n\t\t\t\t\t\t</summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-2112\" class=\"elementor-element elementor-element-15ebdba e-con-full e-flex e-con e-child\" data-id=\"15ebdba\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-628baaa elementor-align-center elementor-widget elementor-widget-button\" data-id=\"628baaa\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https://stathis.com.gr/wp-content/uploads/2025/07/MercedesBenzGreeceVansModified_19738371_1.0.pdf\" target=\"_blank\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Data sheet</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</d