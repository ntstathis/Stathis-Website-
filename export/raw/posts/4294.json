  data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/Koala-green-495-aperto-600x900-1.webp\"\n    data-title=\"Koala-green-495-aperto-600x900\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 600px; --smush-placeholder-aspect-ratio: 600/900;\">\n\n<img decoding=\"async\" alt=\"Koala-green-495-aperto-con-scatole\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/Koala-green-495-aperto-con-scatole-768x1152.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/Koala-green-495-aperto-con-scatole-683x1024.webp\"\n    data-title=\"Koala-green-495-aperto-con-scatole\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/1152;\">\n\n<img decoding=\"async\" alt=\"Koala-green-495-retro\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/Koala-green-495-retro-768x1152.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/Koala-green-495-retro-683x1024.webp\"\n    data-title=\"Koala-green-495-retro\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/1152;\">\n\n<img decoding=\"async\" alt=\"Koala-green-495-chiuso\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/Koala-green-495-chiuso-768x1152.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/Koala-green-495-chiuso-683x1024.webp\"\n    data-title=\"Koala-green-495-chiuso\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/1152;\">\n\n<img decoding=\"async\" alt=\"KOALA-GREEN-495-1-600x400\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-GREEN-495-1-600x400-1.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-GREEN-495-1-600x400-1.webp\"\n    data-title=\"KOALA-GREEN-495-1-600x400\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 600px; --smush-placeholder-aspect-ratio: 600/400;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"0\" data-end=\"240\">The <strong data-start=\"4\" data-end=\"23\">KOALA GREEN 495</strong> is a self-contained refrigerated insulated container, designed for the safe transport of perishable goods under controlled temperatures. Thanks to its integrated rechargeable battery, it ensures autonomous operation.</p><ul data-start=\"242\" data-end=\"1161\" data-is-last-node=\"\" data-is-only-node=\"\"><li data-start=\"242\" data-end=\"330\"><p data-start=\"244\" data-end=\"330\"><strong data-start=\"244\" data-end=\"265\">Internal capacity</strong>: 495 liters, ideal for transporting fresh and frozen products.</p></li><li data-start=\"331\" data-end=\"435\"><p data-start=\"333\" data-end=\"435\"><strong data-start=\"333\" data-end=\"350\">ATP certified</strong>, in accordance with international standards for the transport of perishable goods.</p></li><li data-start=\"436\" data-end=\"531\"><p data-start=\"438\" data-end=\"531\"><strong data-start=\"438\" data-end=\"458\">Durable material</strong>: Polyethylene structure with high insulation, built for intensive use.</p></li><li data-start=\"532\" data-end=\"657\"><p data-start=\"534\" data-end=\"657\"><strong data-start=\"534\" data-end=\"556\">Thermal insulation</strong>: Eco-friendly polyurethane foam, free of CFCs and HCFCs, ensuring excellent temperature retention.</p></li><li data-start=\"658\" data-end=\"789\"><p data-start=\"660\" data-end=\"789\"><strong data-start=\"660\" data-end=\"687\">Autonomous power supply</strong>: Built-in rechargeable battery that allows independent operation without a continuous power source.</p></li><li data-start=\"790\" data-end=\"904\"><p data-start=\"792\" data-end=\"904\"><strong data-start=\"792\" data-end=\"813\">Flexible charging</strong>: Can be charged via 230V AC or with an external power adapter, offering versatile usage.</p></li><li data-start=\"905\" data-end=\"1028\"><p data-start=\"907\" data-end=\"1028\"><strong data-start=\"907\" data-end=\"934\">Integrated cooling unit</strong>: Provides precise and reliable temperature control, maintaining optimal storage conditions.</p></li><li data-start=\"1029\" data-end=\"1161\" data-is-last-node=\"\"><p data-start=\"1031\" data-end=\"1161\" data-is-last-node=\"\"><strong data-start=\"1031\" data-end=\"1077\">Optimized internal dimensions (600×400 mm)</strong>: Ideal for boxes and trays, maximizing loading capacity and operational efficiency.</p></li></ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b80f4fb e-con-full e-flex e-con e-child\" data-id=\"b80f4fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9fc7267 elementor-widget elementor-widget-image\" data-id=\"9fc7267\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/haccp2.webp\" class=\"attachment-large size-large wp-image-2874 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-57b5a8b elementor-widget elementor-widget-image\" data-id=\"57b5a8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/riciclo2.webp\" class=\"attachment-large size-large wp-image-2875 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-54c0076 e-con-full e-flex e-con e-child\" data-id=\"54c0076\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-32056d2 elementor-align-center elementor-widget elementor-widget-button\" data-id=\"32056d2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA_GREEN_495_contenitore_refrigerato_rev2-en.pdf\" target=\"_blank\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Data sheet</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9444840 elementor-widget elementor-widget-html\" data-id=\"9444840\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\n\n#singlePage .post_title_wrapper .date {\n\n \n display: none !important;\n\n\n\n}\n\n</style>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t",
