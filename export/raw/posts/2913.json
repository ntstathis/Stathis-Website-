06/K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0M0-1.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0M0-1.webp\"\n    data-title=\"K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0M0-1\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 743px; --smush-placeholder-aspect-ratio: 743/743;\">\n\n<img decoding=\"async\" alt=\"K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0-2\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0-2-768x766.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0-2.webp\"\n    data-title=\"K50ASISDZM0K50ASISBZM0K50ASISCZM0K50ASISDYK50ASISCYM0K50ASISBYM0-2\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/766;\">\n\n<img decoding=\"async\" alt=\"K50ASISBZM0\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/K50ASISBZM0.webp\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/K50ASISBZM0.webp\"\n    data-title=\"K50ASISBZM0\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 667px; --smush-placeholder-aspect-ratio: 667/1000;\">\n\n<img decoding=\"async\" alt=\"KOALA-50\"\n   data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-50-768x511.jpg\"\n    data-image=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA-50-1024x682.jpg\"\n    data-title=\"KOALA-50\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" class=\"lazyload\" style=\"--smush-placeholder-width: 768px; --smush-placeholder-aspect-ratio: 768/511;\">\n\n  </div>\n</div>\n<!-- end Compact Gallery -->\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3ad1858 e-flex e-con-boxed e-con e-parent\" data-id=\"3ad1858\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-3fca8d6 e-con-full e-flex e-con e-child\" data-id=\"3fca8d6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a01766a elementor-widget elementor-widget-text-editor\" data-id=\"a01766a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Το Koala 50 είναι το ιδανικό κινητό ψυκτικό εμπορευματοκιβώτιο για την ασφαλή μεταφορά προϊόντων ελεγχόμενης θερμοκρασίας.</p><ul><li>Στιβαρή κατασκευή: CFCs και HCFCs, εξασφαλίζει άριστη θερμική απόδοση, προστατεύει τις οργανοληπτικές ιδιότητες των μεταφερόμενων προϊόντων και μειώνει τον κίνδυνο ανάπτυξης βακτηρίων.</li><li>Βέλτιστη χωρητικότητα: 53 λίτρα, ιδανική για τη μεταφορά εργαστηριακών δειγμάτων ή άλλων ευαίσθητων στη θερμοκρασία προϊόντων.</li><li>Ενσωματωμένες λαβές: Πρακτικές λαβές από ανοξείδωτο χάλυβα για ασφαλές κράτημα και εύκολη μεταφορά.</li><li>Εσωτερική προστασία: Εξοπλισμένο με προστατευτικό πλέγμα εξατμιστή, κατασκευασμένο από μεταλλικό σύρμα με πλαστική επικάλυψη, που εξασφαλίζει ασφάλεια και μακροχρόνια αντοχή.</li><li>Πρακτικός σχεδιασμός: Άνοιγμα από πάνω για απλή και άμεση πρόσβαση στα προϊόντα.</li><li>Διπλή τροφοδοσία: Συμβατή με 12Vdc και 230Vac, προσφέροντας ευέλικτη χρήση εν κινήσει και σε σταθερούς χώρους.</li></ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5f8b84b e-con-full e-flex e-con e-child\" data-id=\"5f8b84b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b80f4fb e-con-full e-flex e-con e-child\" data-id=\"b80f4fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9fc7267 elementor-widget elementor-widget-image\" data-id=\"9fc7267\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/haccp2.webp\" class=\"attachment-large size-large wp-image-2874 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-57b5a8b elementor-widget elementor-widget-image\" data-id=\"57b5a8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"100\" height=\"100\" data-src=\"https://stathis.com.gr/wp-content/uploads/2025/06/riciclo2.webp\" class=\"attachment-large size-large wp-image-2875 lazyload\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 100px; --smush-placeholder-aspect-ratio: 100/100;\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-54c0076 e-con-full e-flex e-con e-child\" data-id=\"54c0076\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-32056d2 elementor-align-center elementor-widget elementor-widget-button\" data-id=\"32056d2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https://stathis.com.gr/wp-content/uploads/2025/06/KOALA_50_contenitore_refrigerato_rev2-en.pdf\" target=\"_blank\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Data sheet</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9444840 elementor-widget elementor-widget-html\" data-id=\"9444840\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\n\n#singlePage .post_title_wrapper .date {\n\n \n display: none !important;\n\n\n\n}\n\n</style>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t",
