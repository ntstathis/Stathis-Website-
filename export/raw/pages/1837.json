  "title": {
    "rendered": "Fish Transportation by LCV"
  },
  "content": {
    "rendered": "\n<h4 class=\"wp-block-heading\">Special equipment for fish transportation</h4>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Stainless steel barriers on the doors</li>\n\n\n\n<li>Construction of polyester bowl on the floor to avoid inflow of waste water under it</li>\n\n\n\n<li>Guttering pipe with valves and plugs on the floor for the easy removal of waste water</li>\n</ul>\n\n\n\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-5 is-layout-flex wp-block-gallery-is-layout-flex\">\n<figure class=\"wp-block-image size-large\"><img decoding=\"async\" width=\"1024\" height=\"768\" data-id=\"1372\" data-src=\"https://stathis.com.gr/wp-content/uploads/2024/05/DSC07426-1024x768-1.jpg\" alt=\"\" class=\"wp-image-1372 lazyload\" data-srcset=\"https://stathis.com.gr/wp-content/uploads/2024/05/DSC07426-1024x768-1.jpg 1024w, https://stathis.com.gr/wp-content/uploads/2024/05/DSC07426-1024x768-1-300x225.jpg 300w, https://stathis.com.gr/wp-content/uploads/2024/05/DSC07426-1024x768-1-768x576.jpg 768w\" data-sizes=\"(max-width: 1024px) 100vw, 1024px\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 1024px; --smush-placeholder-aspect-ratio: 1024/768;\" /></figure>\n\n\n\n<figure class=\"wp-block-image size-large\"><img decoding=\"async\" width=\"936\" height=\"1024\" data-id=\"1374\" data-src=\"https://stathis.com.gr/wp-content/uploads/2024/05/ps2-2-936x1024-1.png\" alt=\"\" class=\"wp-image-1374 lazyload\" data-srcset=\"https://stathis.com.gr/wp-content/uploads/2024/05/ps2-2-936x1024-1.png 936w, https://stathis.com.gr/wp-content/uploads/2024/05/ps2-2-936x1024-1-274x300.png 274w, https://stathis.com.gr/wp-content/uploads/2024/05/ps2-2-936x1024-1-768x840.png 768w\" data-sizes=\"(max-width: 936px) 100vw, 936px\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 936px; --smush-placeholder-aspect-ratio: 936/1024;\" /></figure>\n\n\n\n<figure class=\"wp-block-image size-large\"><img decoding=\"async\" width=\"518\" height=\"548\" data-id=\"1373\" data-src=\"https://stathis.com.gr/wp-content/uploads/2024/05/ps3.png\" alt=\"\" class=\"wp-image-1373 lazyload\" data-srcset=\"https://stathis.com.gr/wp-content/uploads/2024/05/ps3.png 518w, https://stathis.com.gr/wp-content/uploads/2024/05/ps3-284x300.png 284w\" data-sizes=\"(max-width: 518px) 100vw, 518px\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 518px; --smush-placeholder-aspect-ratio: 518/548;\" /></figure>\n\n\n\n<figure class=\"wp-block-image size-large\"><img decoding=\"async\" width=\"984\" height=\"1024\" data-id=\"1375\" data-src=\"https://stathis.com.gr/wp-content/uploads/2024/05/ps5-6-984x1024-1.png\" alt=\"\" class=\"wp-image-1375 lazyload\" data-srcset=\"https://stathis.com.gr/wp-content/uploads/2024/05/ps5-6-984x1024-1.png 984w, https://stathis.com.gr/wp-content/uploads/2024/05/ps5-6-984x1024-1-288x300.png 288w, https://stathis.com.gr/wp-content/uploads/2024/05/ps5-6-984x1024-1-768x799.png 768w\" data-sizes=\"(max-width: 984px) 100vw, 984px\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" style=\"--smush-placeholder-width: 984px; --smush-placeholder-aspect-ratio: 984/1024;\" /></figure>\n</figure>\n",
